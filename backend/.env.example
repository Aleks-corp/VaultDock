PORT=4000
# MongoDB Atlas connection string (see README for how to get one)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vaultdock?appName=VaultDock
# Any long random string, used to sign JWTs
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173
# From Google Cloud Console > APIs & Services > Credentials (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
# Optional: public URL of this server, used to self-ping every 13 min so free-tier
# hosts (e.g. Render) don't spin down from inactivity. On Render this is auto-set via
# RENDER_EXTERNAL_URL, so you usually don't need to set this yourself.
SELF_URL=
